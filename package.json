{
  "name": "client-action-room",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "cargo run --manifest-path server/Cargo.toml",
    "check": "svelte-check --tsconfig ./tsconfig.json && cargo fmt --manifest-path server/Cargo.toml --check && cargo clippy --manifest-path server/Cargo.toml --locked --all-targets -- -D warnings",
    "test:web": "vitest run",
    "test:api": "cargo test --manifest-path server/Cargo.toml --locked",
    "test:e2e": "playwright test",
    "test": "npm run test:web && npm run test:api",
    "build:web": "vite build",
    "build:api": "cargo build --manifest-path server/Cargo.toml --release --locked",
    "build": "npm run build:web && npm run build:api",
    "preview": "vite preview"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.25.0",
    "svelte": "5.56.10"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.58.2",
    "@sveltejs/vite-plugin-svelte": "6.1.3",
    "@tsconfig/svelte": "5.0.5",
    "svelte-check": "4.3.1",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=22"
  }
}
